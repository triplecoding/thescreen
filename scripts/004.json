    {"say": "চার বছরের বন্ধুরা ওকে গ্রুপ থেকে *বাদ দিয়েছে*। কোনো কারণ বলেনি।",
     "scene": {"widget": {"kind": "chat", "title": "ক্লাস নাইন বেস্টিজ 💛", "msgs": [{"who": "সিস্টেম", "t": "তোমাকে গ্রুপ থেকে রিমুভ করা হয়েছে"}]}, "cam": {"focus": "nabila", "zoom": 1.3}}},
    {"voice": "abbu", "say": "আরে, এত মন খারাপের কী আছে? অন্য বন্ধু বানা।", "scene": {"widget": null, "arms": {"abbu": "talk", "nabila": "down"}, "holds": {"nabila": "none"}, "cam": {"focus": "abbu", "zoom": 1.35}}},
    {"voice": "nabila", "tone": "sad", "say": "হ্যাঁ, কিন্তু সবাই তো *ওদের দলে*।", "scene": {"arms": {"abbu": "down"}, "cam": {"focus": "nabila", "zoom": 1.4}}},
    {"voice": "abbu", "say": "তাহলে টিচারকে বল।", "scene": {"arms": {"abbu": "point"}, "cam": {"focus": "abbu", "zoom": 1.35}}},
    {"voice": "nabila", "say": "হ্যাঁ, কিন্তু তাহলে ওরা আরও *রেগে যাবে*।", "scene": {"arms": {"abbu": "down"}, "cam": {"focus": "nabila", "zoom": 1.4}}},
