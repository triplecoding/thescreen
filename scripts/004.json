  "beats": [
    {"say": "যে মেয়ে বাসায় ঢুকেই সারাদিনের গল্প শোনাত, সেদিন স্কুল থেকে ফিরে নাবিলা কারও সাথে *একটা কথাও* বলেনি।",
     "scene": {"set": "home", "light": "evening", "chip": "সন্ধ্যা ছয়টা", "props": ["sofa", "window"],
