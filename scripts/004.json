    {"say": "এবার কোনো উপদেশ নয়। শুধু একটা প্রশ্ন—", "scene": {"cam": {"focus": "abbu", "zoom": 1.3}}},
    {"voice": "abbu", "tone": "softly", "say": "খুব *একা* লাগছিল, না রে?", "pause": 1.0,
     "scene": {"arms": {"abbu": "down"}, "holds": {"abbu": "none"}, "cam": {"focus": "nabila", "zoom": 1.35}}},
    {"say": "নাবিলা আর চোখের পানি আটকাতে পারল না। আব্বুর কাঁধে মাথা রেখে, একটা একটা করে *সব খুলে* বলল।", "tone": "softly",
